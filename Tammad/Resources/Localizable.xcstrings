    "The server has moved to another address (%@). For your security, the app does not follow this redirect automatically. Please check the server address and sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server ist an eine andere Adresse umgezogen (%@). Zu Ihrer Sicherheit folgt die App dieser Weiterleitung nicht automatisch. Bitte prüfen Sie die Serveradresse und melden Sie sich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server has moved to another address (%@). For your security, the app does not follow this redirect automatically. Please check the server address and sign in again."
          }
        }
      }
    },
    "The server no longer accepts your credentials, for example because your password or API token changed. Please sign in again." : {
