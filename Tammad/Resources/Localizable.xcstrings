    "Configure your own AI API to generate intelligent responses to ticket messages. The API key is stored securely in your device's keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurieren Sie Ihre eigene AI-API, um intelligente Antworten auf Ticket-Nachrichten zu generieren. Der API-Key wird sicher im Keychain Ihres Geräts gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure your own AI API to generate intelligent responses to ticket messages. The API key is stored securely in your device's keychain."
          }
        }
      }
    },
